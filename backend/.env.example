# Configurações do Servidor Node.js
PORT=3001

# Configurações do Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=controle_alvenaria

# Alternativamente, você pode usar DATABASE_URL:
